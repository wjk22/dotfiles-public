# Editor: nvim when it's there, vi otherwise
if command -v nvim >/dev/null; then
  alias vim='nvim'
  alias vi='nvim'
  alias v='nvim'
else
  alias v='vi'
fi
alias evi='v ~/.config/nvim'

# Mail: short name to match nvim.
alias nmutt='neomutt'

# Shared aliases: eal. Personal overrides: eall (loaded last below).
alias eal='v ~/.alias ; source ~/.alias'
alias eall='v ~/.alias.local ; source ~/.alias'

# Debian's names for bat and fd
command -v bat >/dev/null || { command -v batcat >/dev/null && alias bat='batcat'; }
command -v fd >/dev/null || { command -v fdfind >/dev/null && alias fd='fdfind'; }
# Homebrew's name for gdu (coreutils already has a gdu: GNU du)
command -v gdu-go >/dev/null && alias gdu='gdu-go'

# Use bat for interactive file viewing; keep the familiar bcat name too.
if command -v bat >/dev/null; then
  alias bcat='bat'
  alias cat='bat'
fi

# Listings: icons and the Windows-style palette in interactive use.
# Keep GNU ls (and its historical LS_COLORS) available via `command ls`.
if command -v eza >/dev/null; then
  export EZA_CONFIG_DIR="${EZA_CONFIG_DIR:-$DOTFILES/linux/.config/eza}"
  function eza {
    # Eza otherwise lets LS_COLORS override the YAML theme. Scope the reset to
    # this command; explicit personal EZA_COLORS overrides still work.
    LS_COLORS= EXA_COLORS= command eza "$@"
  }
  alias ls='eza --icons=auto'
  alias ll='eza --icons=auto -l'
  alias lla='eza --icons=auto -la'
  alias el='eza --icons=auto -l'
  alias es='eza --icons=auto'
  alias esa='eza --icons=auto -la'
else
  alias ls='ls --color=auto'
  alias ll='ls -l'
  alias lla='ls -la'
  alias el='ls -l'
  alias es='ls'
  alias esa='ls -la'
fi
alias lt='du -sh * | sort -h'

# Other
alias g=git
alias c=clear
alias k='kill -9'
alias f='find . -name'
alias ..='cd ..'
alias ...='cd ../..'
alias h='history'
alias hh='history 10'
alias df='df -h'
alias du='du -h'
alias cpv='rsync -ah --info=progress2'

# Network (macOS has no ss)
if command -v ss >/dev/null; then
  alias ports='ss -tulanp'
else
  alias ports='lsof -nP -iTCP -sTCP:LISTEN -iUDP'
fi

# Cheat sheet for this setup
help-dots() {
  local viewer
  # $commands sees real programs only; command -v would also match the bat alias.
  for viewer in bat batcat; do
    if (( $+commands[$viewer] )); then
      "$viewer" --theme=ansi --style=plain --language=markdown --paging=always "$DOTFILES/HELP.md"
      return
    fi
  done
  less "$DOTFILES/HELP.md"
}

# Put personal aliases/overrides in ~/.alias.local, not this shared file.
[[ ! -r ~/.alias.local ]] || source ~/.alias.local
