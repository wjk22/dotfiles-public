# Editor: nvim when it's there, vi otherwise
if command -v nvim >/dev/null; then
  alias vim='nvim'
  alias vi='nvim'
  alias v='nvim'
else
  alias v='vi'
fi
alias evi='v ~/.config/nvim'

# Mail: short name to match nvim.
alias nmutt='neomutt'

# Shared aliases: eal. Personal overrides: eall (loaded last below).
alias eal='v ~/.alias ; source ~/.alias'
alias eall='v ~/.alias.local ; source ~/.alias'

# Debian's names for bat and fd
command -v bat >/dev/null || { command -v batcat >/dev/null && alias bat='batcat'; }
command -v fd >/dev/null || { command -v fdfind >/dev/null && alias fd='fdfind'; }
# Homebrew's name for gdu (coreutils already has a gdu: GNU du)
command -v gdu-go >/dev/null && alias gdu='gdu-go'

# Use bat for interactive file viewing; keep the familiar bcat name too.
if command -v bat >/dev/null; then
  alias bcat='bat'
  alias cat='bat'
fi

# Listings: icons and the Windows-style palette in interactive use.
# Keep GNU ls (and its historical LS_COLORS) available via `command ls`.
if command -v eza >/dev/null; then
  export EZA_CONFIG_DIR="${EZA_CONFIG_DIR:-$DOTFILES/linux/.config/eza}"
  function eza {
    # Eza otherwise lets LS_COLORS override the YAML theme. Scope the reset to
    # this command; explicit personal EZA_COLORS overrides still work.
    LS_COLORS= EXA_COLORS= command eza "$@"
  }
  alias ls='eza --icons=auto'
  alias ll='eza --icons=auto -l'
  alias lla='eza --icons=auto -la'
  alias el='eza --icons=auto -l'
  alias es='eza --icons=auto'
  alias esa='eza --icons=auto -la'
else
  # macOS has BSD ls, which does not support GNU's --color=auto.
  # Prefer Homebrew's GNU ls when available; otherwise use BSD's -G.
  if [[ $OSTYPE == darwin* ]]; then
    if command -v gls >/dev/null; then
      alias ls='gls --color=auto'
    else
      alias ls='ls -G'
    fi
  else
    alias ls='ls --color=auto'
  fi
  alias ll='ls -l'
  alias lla='ls -la'
  alias el='ls -l'
  alias es='ls'
  alias esa='ls -la'
fi
alias lt='du -sh * | sort -h'

# Other
alias g=git
alias c=clear
alias k='kill -9'
alias f='find . -name'
alias ..='cd ..'
alias ...='cd ../..'
alias h='history'
alias hh='history 10'
alias df='df -h'
alias du='du -h'
alias cpv='rsync -ah --info=progress2'

# Network (macOS has no ss)
if command -v ss >/dev/null; then
  alias ports='ss -tulanp'
else
  alias ports='lsof -nP -iTCP -sTCP:LISTEN -iUDP'
fi

# nssh: ssh that remembers. `nssh [ssh options] host` connects and keeps the
# arguments; `nssh` picks from the list, `nssh list` shows it numbered with a
# name and when it was last used (most recent first, then the hosts in
# ~/.ssh/config). `nssh 3` or `nssh name` connects, `nssh r 3 name` names an
# entry, `nssh d 3` deletes one. A failed connection (ssh exits 255) is not
# remembered. List: ~/.local/share/nssh/hosts, one "time<TAB>name<TAB>args".
_nssh_load() {
  local file=${XDG_DATA_HOME:-$HOME/.local/share}/nssh/hosts line h
  typeset -ga _nssh_when _nssh_name _nssh_args
  _nssh_when=() _nssh_name=() _nssh_args=()
  if [[ -r $file ]]; then
    while IFS= read -r line; do
      [[ -n $line ]] || continue
      if [[ $line == *$'\t'*$'\t'* ]]; then
        _nssh_when+=(${line%%$'\t'*}); line=${line#*$'\t'}
        _nssh_name+=("${line%%$'\t'*}") _nssh_args+=("${line#*$'\t'}")
      else
        _nssh_when+=(0) _nssh_name+=('') _nssh_args+=("$line")  # list without names or times
      fi
    done < $file
  fi
  [[ -r ~/.ssh/config ]] || return 0
  for h in ${(f)"$(awk 'tolower($1) == "host" { for (i = 2; i <= NF; i++) if ($i !~ /[*?!]/) print $i }' ~/.ssh/config)"}; do
    (( ${_nssh_args[(Ie)$h]} || ${_nssh_name[(Ie)$h]} )) && continue
    _nssh_when+=(-1) _nssh_name+=("$h") _nssh_args+=("$h")
  done
}
_nssh_save() {
  local file=${XDG_DATA_HOME:-$HOME/.local/share}/nssh/hosts i
  mkdir -p -- ${file:h}
  for (( i = 1; i <= $#_nssh_args; i++ )); do
    (( _nssh_when[i] >= 0 )) && print -r -- "${_nssh_when[i]}"$'\t'"${_nssh_name[i]}"$'\t'"${_nssh_args[i]}"
  done | sort -t $'\t' -k1,1nr -s >| $file.tmp && mv -f -- $file.tmp $file
  _nssh_load
}
_nssh_ago() {
  local d=$(( EPOCHSECONDS - $1 ))
  if (( $1 < 0 )); then print -r -- 'ssh config'
  elif (( $1 == 0 )); then print -r -- '-'
  elif (( d < 60 )); then print -r -- 'just now'
  elif (( d < 3600 )); then print -r -- "$(( d / 60 ))m ago"
  elif (( d < 86400 )); then print -r -- "$(( d / 3600 ))h ago"
  elif (( d < 7 * 86400 )); then print -r -- "$(( d / 86400 ))d ago"
  else strftime '%Y-%m-%d' $1
  fi
}
_nssh_show() {
  local i w=4 n
  for n in $_nssh_name; do (( $#n > w )) && w=$#n; done
  for (( i = 1; i <= $#_nssh_args; i++ )); do
    printf "%3d  %-${w}s  %-10s  %s\n" $i "${_nssh_name[i]}" "$(_nssh_ago ${_nssh_when[i]})" "${_nssh_args[i]}"
  done
}
_nssh_index() {
  if [[ $1 == <-> ]] && (( $1 >= 1 && $1 <= $#_nssh_args )); then print -r -- $1; return; fi
  [[ $1 != <-> ]] && (( ${_nssh_name[(Ie)$1]} )) && { print -r -- ${_nssh_name[(Ie)$1]}; return }
  print -u2 -r -- "nssh: no entry $1 (see nssh list)"; return 1
}
nssh() {
  zmodload zsh/datetime
  _nssh_load
  local i pick line rc
  if [[ $# -eq 1 && $1 == list ]]; then _nssh_show; return; fi
  if [[ $# -eq 3 && $1 == r ]]; then
    i=$(_nssh_index $2) || return 1
    if [[ $3 == (*[[:space:]]*|<->|list|r|d) ]]; then print -u2 -r -- "nssh: a name is one word, not a number or list/r/d"; return 1; fi
    if (( ${_nssh_name[(Ie)$3]} && ${_nssh_name[(Ie)$3]} != i )); then print -u2 -r -- "nssh: $3 is taken"; return 1; fi
    _nssh_name[i]=$3; (( _nssh_when[i] < 0 )) && _nssh_when[i]=0
    _nssh_save; _nssh_show; return
  fi
  if [[ $# -eq 2 && $1 == d ]]; then
    i=$(_nssh_index $2) || return 1
    if (( _nssh_when[i] < 0 )); then print -u2 -r -- "nssh: ${_nssh_args[i]} comes from ~/.ssh/config; remove it there"; return 1; fi
    _nssh_when[i]=() _nssh_name[i]=() _nssh_args[i]=()
    _nssh_save; _nssh_show; return
  fi
  i=0
  if (( $# == 0 )); then
    (( $#_nssh_args )) || { print -r -- 'nssh: nothing remembered yet; "nssh user@host" connects and remembers it.'; return }
    if (( $+commands[fzf] )); then
      pick=$(_nssh_show | fzf --no-sort --reverse --height=40% --prompt='nssh> ') || return
      i=${${(s: :)pick}[1]}
    else
      _nssh_show; read -r 'i?Number: '
    fi
    i=$(_nssh_index "$i") || return
  elif (( $# == 1 )) && { [[ $1 == <-> ]] || (( ${_nssh_name[(Ie)$1]} )) }; then
    i=$(_nssh_index $1) || return
  fi
  (( i )) && set -- ${(Q)${(z)_nssh_args[i]}}
  command ssh "$@"
  rc=$?
  if (( rc != 255 )); then
    line=${(j: :)${(q-)@}}
    i=${_nssh_args[(Ie)$line]} pick=
    if (( i )); then pick=${_nssh_name[i]}; _nssh_when[i]=() _nssh_name[i]=() _nssh_args[i]=(); fi
    _nssh_when=($EPOCHSECONDS $_nssh_when) _nssh_name=("$pick" "${_nssh_name[@]}") _nssh_args=("$line" "${_nssh_args[@]}")
    _nssh_save
  fi
  return rc
}

# Cheat sheet for this setup
help-dots() {
  local viewer
  # $commands sees real programs only; command -v would also match the bat alias.
  for viewer in bat batcat; do
    if (( $+commands[$viewer] )); then
      "$viewer" --theme=ansi --style=plain --language=markdown --paging=always "$DOTFILES/HELP.md"
      return
    fi
  done
  less "$DOTFILES/HELP.md"
}

# Put personal aliases/overrides in ~/.alias.local, not this shared file.
[[ ! -r ~/.alias.local ]] || source ~/.alias.local
