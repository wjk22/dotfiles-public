set use_threads = threads
set sort = reverse-last-date-received
set sort_aux = date-sent
set index_format = "%4C %Z %{%d %b} %-20.20L %s"
set pager_index_lines = 8
set pager_context = 3
set status_on_top = no
# A compact lualine-like status: mode, mailbox, counts and position.
set status_format = " MAIL  %f %> %m messages  %?n?%n new  ?%P "
set pager_format = " READ  %C/%m  %n %> %s  %P "

ignore *
unignore From: To: Cc: Date: Subject: Reply-To:
hdr_order From: To: Cc: Date: Subject:

set sidebar_visible = yes
set sidebar_width = 26
set sidebar_short_path = yes
set sidebar_folder_indent = yes
set sidebar_indent_string = "  "
set sidebar_format = "%B%* %N"
set sidebar_sort_method = path

# Keep the default account, transport, deletion and reply behaviour.
