# Wojtek's 1996 colours, kept in GNU dircolors format.
# zsh loads this file for ls and completion listings.
# Regular/source/document files keep the terminal's normal colour.

# Colour-capable terminals, including WSL, tmux and modern terminal emulators.
TERM ansi
TERM linux*
TERM console
TERM cygwin
TERM xterm*
TERM screen*
TERM tmux*
TERM rxvt*
TERM putty*
TERM st
TERM st-*
TERM alacritty*
TERM foot*
TERM kitty*
TERM wezterm*
TERM Eterm
TERM eterm-color
TERM gnome*
TERM konsole*
COLORTERM ?*

# Original file-type colours.
NORMAL 00
FILE 00
DIR 01;34
LINK 01;36
FIFO 40;33
SOCK 01;35
BLK 40;33;01
CHR 40;33;01
ORPHAN 40;31;01
EXEC 01;32

# Archives: bold red. Original extensions plus today's common formats.
.tar 01;31
.tgz 01;31
.arj 01;31
.taz 01;31
.lzh 01;31
.zip 01;31
.z   01;31
.Z   01;31
.gz  01;31
.deb 01;31
.7z  01;31
.rar 01;31
.bz2 01;31
.tbz 01;31
.tbz2 01;31
.xz  01;31
.txz 01;31
.zst 01;31
.tzst 01;31
.lz4 01;31
.rpm 01;31

# Images: bold magenta.
.jpg 01;35
.gif 01;35
.bmp 01;35
.ppm 01;35
.tga 01;35
.xbm 01;35
.xpm 01;35
.tif 01;35
.jpeg 01;35
.png 01;35
.tiff 01;35
.svg 01;35
.svgz 01;35
.webp 01;35
.avif 01;35
.heic 01;35

# Video/animation: bold white, including the old GL and DL formats.
.mpg 01;37
.avi 01;37
.gl  01;37
.dl  01;37
.mpeg 01;37
.mp4 01;37
.m4v 01;37
.mkv 01;37
.mov 01;37
.webm 01;37
